{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenManager",
  "version": "2.0.0",
  "identifier": "com.screenmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Manager",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOTFDN0MyMUNGMUMzRjMKUldUencvRWN3c2VSdm5IZEhwcjR6TGJKcVFmNndqMEdqaXFZaUpMSzlJWE01Y0haMnYyTEZJU2gK",
      "endpoints": [
        "https://mirror.ghproxy.com/https://github.com/tsglz/ScreenManager/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/tsglz/ScreenManager/releases/latest/download/latest.json",
        "https://github.com/tsglz/ScreenManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
