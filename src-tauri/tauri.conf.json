{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenManager",
  "version": "1.0.1",
  "identifier": "com.screenmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Manager",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "createUpdaterArtifacts": true,
  "active": true,
  "targets": "all",
  "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOTFDN0MyMUNGMUMzRjMKUldUencvRWN3c2VSdm5IZEhwcjR6TGJKcVFmNndqMEdqaXFZaUpMSzlJWE01Y0haMnYyTEZJU2gK",
      "endpoints": [
        "https://github.com/tsglz/ScreenManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
